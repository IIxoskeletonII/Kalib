{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kalib",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-18",
  // Static PWA from dist/ plus a small API (Open Food Facts proxy). /api/* runs the Worker
  // first; everything else is served as assets with SPA fallback.
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // SPEC §9.3: the vision model is swappable here. The OpenRouter key is a secret:
  //   npx wrangler secret put OPENROUTER_API_KEY
  "vars": {
    "VISION_MODEL": "google/gemini-3.1-flash-lite",
    // Reminders (Web Push). Public half of the VAPID pair; the private half is a secret:
    //   npx wrangler secret put VAPID_PRIVATE_KEY
    "VAPID_PUBLIC_KEY": "BICboEhUpK6WeD5834AfZ2kfDsDY2_AEOgbq1okYfpu2vSN3tkf1cstmSe3l4mmmkgWzp5T0sw4RJRrkZAOJ8y8",
    "VAPID_SUBJECT": "mailto:allameliya@gmail.com"
  },
  // Push subscriptions live in KV. Create once with `npx wrangler kv namespace create PUSH`
  // and paste the id here; without the binding the reminders UI says so and does nothing.
  "kv_namespaces": [{ "binding": "PUSH", "id": "079cc1615c694a8a8afcef454dad7ad4" }],
  // The cron sends due reminders; a 10-minute grid is fine for "around 07:30".
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
