{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kalib",
  "compatibility_date": "2026-09-18",
  // Static hosting on Workers (the successor to Cloudflare Pages). No server code in v0;
  // the v3 vision proxy will be added as a fetch handler in this same Worker.
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  }
}
